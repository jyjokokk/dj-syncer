{
	"name": "dj-syncer",
	"version": "1.0.0",
	"description": "Playlist syncing helper for DJs",
	"main": "src/index.ts",
	"author": "Jyrki Kokkola <j.j.kokkola@gmail.com>",
	"license": "MIT",
	"private": true,
	"scripts": {
		"start": "bun src/index.ts",
		"launch": "scripts/cleanup.sh && bun start",
		"dev": "bun --watch src/index.ts",
		"dev:hot": "bun --watch --hot src/index.ts",
		"lint": "biome check",
		"format": "biome format --fix src",
		"test": "bun test src",
		"test:cov": "bun test src --coverage",
		"test:watch:cov": "bun test src --watch --coverage",
		"test:watch": "bun test src --watch",
		"test:int": "bun test tests",
		"smoke:spotify": "bun scripts/smoke-spotify.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"zod": "^4.4.1"
	}
}
